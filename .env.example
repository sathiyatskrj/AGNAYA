# ==============================================================================
# AGNAYA V3.1 - Environment Configuration Template
# DISCLAIMER: SIMULATION ONLY – NOT AN OFFICIAL WARNING.
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Server bindings (defaults to localhost for secure isolation)
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Optional API Security Key (Leave empty to allow open access during local hackathon demo)
# If set, all requests must include the header 'X-API-Key: your-secret-token'
API_KEY=

# Optional CARTO Basemap Key
# If left empty, AGNAYA automatically renders keyless OpenStreetMap / Positron tiles
CARTO_API_KEY=

# Allowed CORS origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","http://localhost:8000","http://127.0.0.1:8000"]

# Maximum requests per minute per client IP (set 0 to disable)
RATE_LIMIT_PER_MINUTE=120
